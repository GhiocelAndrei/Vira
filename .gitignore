# ---- .NET ----
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/
[Dd]ebug/
[Rr]elease/
artifacts/

# ---- Node / frontend ----
node_modules/
dist/
.vite/
*.local
.vercel/

# ---- Python / ai-service ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# ---- env & secrets (never commit) ----
.env
.env.*
!.env.example
*.pem
serviceAccount*.json
firebase-admin*.json

# ---- data / local infra ----
pgdata/
*.log

# ---- ai-service local test clips (drop your own, never commit video files) ----
ai-service/samples/*
!ai-service/samples/.gitkeep

# ---- IDE / OS ----
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# ---- Expo ----
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
ios/
android/

# Agent skills — vendored from public repos, reinstalled from the lockfile.
# `skills-lock.json` is committed so `npx skills install` reproduces exactly
# these versions; the content itself is thousands of lines of somebody else's
# markdown and does not belong in our history. `.claude/skills` is symlinks.
.agents/
.claude/skills/
