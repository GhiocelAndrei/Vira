# ==========================================================================
# Vira — environment template. Copy to .env and fill in. NEVER commit .env.
# ==========================================================================

# ---- Postgres (local dev via docker-compose) ----
POSTGRES_USER=vira
POSTGRES_PASSWORD=vira_local_dev
POSTGRES_DB=vira
# Connection string the .NET backend uses (schema-per-service; one instance)
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=vira;Username=vira;Password=vira_local_dev

# ---- ai-service (Python/FastAPI) ----
AI_SERVICE_URL=http://localhost:8000
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx           # server-side only, never sent to frontend
GEMINI_API_KEY=AIzaSyxxxxxxxx               # Google AI Studio free tier — Video Analyzer agent

# ---- TikTok (Login Kit + Display API) — .NET config binding uses double underscores ----
TikTok__ClientKey=xxxxxxxx
TikTok__ClientSecret=xxxxxxxx
# The redirect URI is the BACKEND callback (the gateway exchanges the code), registered exactly
# like this in the TikTok app. Local: http://localhost:8080/auth/tiktok/callback
TikTok__RedirectUri=http://localhost:8080/auth/tiktok/callback

# Where the backend sends the browser after a successful creator login (the SPA origin).
App__WebBaseUrl=http://localhost:5173

# ---- Firebase (business auth) — .NET config binding uses double underscores ----
Firebase__ProjectId=vira-demo
# Local dev: path to the Firebase Admin service-account JSON (backend verifies ID tokens).
Firebase__CredentialsPath=./secrets/firebase-admin.json
# Cloud: inject the service-account JSON inline instead (from Key Vault) — takes precedence:
# Firebase__CredentialsJson={"type":"service_account", ...}
Firebase__StorageBucket=vira-demo.appspot.com

# ---- CORS: origins allowed to send the session cookie to the backend ----
App__AllowedOrigins__0=http://localhost:5173
# App__AllowedOrigins__1=https://<your-app>.vercel.app

# ---- Service-to-service (ai-service → backend CreatorController) ----
# Backend validates this shared key on POST /creator/{id}/analysis (X-Service-Key header).
Service__ApiKey=change-me-service-key
# ai-service side (Python): where the backend is + the same shared key.
BACKEND_BASE_URL=http://localhost:8080
BACKEND_SERVICE_KEY=change-me-service-key

# ---- Frontend (Vite; only VITE_* vars reach the browser) ----
VITE_API_BASE_URL=http://localhost:8080
# From Firebase console → Project settings → Your apps → Web app config:
VITE_FIREBASE_API_KEY=xxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=vira-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vira-demo
VITE_FIREBASE_APP_ID=1:xxxxxxxx:web:xxxxxxxx
VITE_FIREBASE_MESSAGING_SENDER_ID=xxxxxxxx
VITE_FIREBASE_STORAGE_BUCKET=vira-demo.appspot.com

# ---- Auth / session ----
SESSION_COOKIE_DOMAIN=localhost
