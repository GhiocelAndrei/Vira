# ==========================================================================
# Vira — environment template. Copy to .env and fill in. NEVER commit .env.
# ==========================================================================

# ---- Postgres (local dev via docker-compose) ----
POSTGRES_USER=vira
POSTGRES_PASSWORD=vira_local_dev
POSTGRES_DB=vira
# Connection string the .NET backend uses (schema-per-service; one instance)
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=vira;Username=vira;Password=vira_local_dev

# ---- ai-service (Python/FastAPI) ----
AI_SERVICE_URL=http://localhost:8000
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx           # server-side only, never sent to frontend
GEMINI_API_KEY=AIzaSyxxxxxxxx               # Google AI Studio free tier — Video Analyzer agent

# ---- TikTok (Display API sandbox) ----
TIKTOK_CLIENT_KEY=xxxxxxxx
TIKTOK_CLIENT_SECRET=xxxxxxxx
TIKTOK_REDIRECT_URI=http://localhost:5173/auth/tiktok/callback

# ---- Firebase (business auth + media storage) ----
FIREBASE_PROJECT_ID=vira-demo
# Path to the Firebase Admin service-account JSON (backend verifies ID tokens)
FIREBASE_ADMIN_CREDENTIALS=./secrets/firebase-admin.json
# Firebase Storage bucket for the ~30 example feed clips
FIREBASE_STORAGE_BUCKET=vira-demo.appspot.com

# ---- Frontend (Vite; only VITE_* vars reach the browser) ----
VITE_API_BASE_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=xxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=vira-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vira-demo
VITE_FIREBASE_STORAGE_BUCKET=vira-demo.appspot.com

# ---- Auth / session ----
SESSION_COOKIE_DOMAIN=localhost
