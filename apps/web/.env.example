# Web app environment. Copy to `apps/web/.env` (git-ignored) and fill in.
# For Vercel, set the same VITE_* vars in the project settings instead.
# Only VITE_-prefixed vars are exposed to the browser (Vite convention).

# ── Backend API ──────────────────────────────────────────────────────────────
# Pick ONE of the setups below.
#
# A) Local backend (dotnet run + docker postgres):
#      VITE_API_BASE_URL=http://localhost:8080
#      (leave VITE_API_PROXY_TARGET unset)
#
# B) Use the DEPLOYED backend while developing locally (recommended) — routes API
#    calls through the Vite dev server so they're same-origin, which keeps the
#    `vira_session` cookie working (no CORS, no third-party-cookie blocking):
#      VITE_API_BASE_URL=/api
#      VITE_API_PROXY_TARGET=https://vira-backend.lemonfield-d6638dd6.westeurope.azurecontainerapps.io
VITE_API_BASE_URL=http://localhost:8080
# VITE_API_PROXY_TARGET=https://vira-backend.lemonfield-d6638dd6.westeurope.azurecontainerapps.io

# ── Dev login (local only) ─────────────────────────────────────────────────────
# Shows a bottom-left bar to sign in as a seeded demo creator/brand without TikTok/Firebase.
# Requires App:DevAuth:Enabled=true on the backend. Do NOT set this in the Vercel/prod build.
# VITE_DEV_AUTH=true

# ── Firebase web config (public by design — shipped in the client bundle) ──────
# Project vira-8b502. From Firebase console → Project settings → General → Your apps.
VITE_FIREBASE_API_KEY=AIzaSyAafnZpd-BC3KC1NfZuGVJzvIGV75YEtbo
VITE_FIREBASE_AUTH_DOMAIN=vira-8b502.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vira-8b502
